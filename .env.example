# 复制为 .env 后填写（.env 已在 .gitignore 中，不会被提交）

# ===== 画面平台选择（默认 agnes；换平台见 docs/providers.md）=====
PROVIDER=agnes

# ===== 默认适配器：Agnes 中国站（生图 / 图生视频）=====
AGNES_API_KEY_CN=
# PROVIDER_BASE_URL=https://api.agnes-ai.cn   # 可选：覆盖适配器默认地址

# ===== 豆包 TTS（火山引擎语音合成）=====
VOLC_VOICE_APP_ID=
VOLC_VOICE_ACCESS_TOKEN=

# 音色与资源必须匹配：
#   预置音色 → seed-tts-2.0
#   克隆音色 → seed-icl-2.0
DOUBAO_SPEAKER=zh_female_shuangkuaisisi_moon_bigtts
DOUBAO_RESOURCE_ID=seed-tts-2.0
